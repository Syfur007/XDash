# Runtime state, namespaced per repo profile (MULTI_REPO_PLAN.md §5):
# data/<profile_name>/terminals_state.json, etc.
data/*/terminals_state.json
data/*/monitors.json
data/*/scheduler.json
data/*/dashboard_logs/
data/*/kaggle_state.json
data/*/kaggle_accounts.json
data/*/kaggle_accounts/
data/*/kaggle_notifications.json
data/*/run_notes.json
data/*/assignments.json
data/*/batches.json
data/_active_repo.json

# System-wide (cross-profile) Kaggle registry — a Kaggle account belongs to a
# person, not a repo, so these live outside any data/<profile>/ subtree. The
# data/*/ patterns above are one level deep and would NOT cover them, and
# data/kaggle_accounts/<name>/ holds real credentials.
data/kaggle_accounts.json
data/kaggle_accounts/

# System-wide Colab registry (Multi_runner_XDash.md Phase 4) — same scope
# reasoning as Kaggle above. data/colab_accounts/<name>/ holds real
# sessions.json/oauth-config.json credentials.
data/colab_accounts.json
data/colab_accounts/

# Machine registry + ssh multiplexing sockets (Multi_runner_XDash.md Phase 1)
# — hosts.json can carry per-machine identity_file paths, and .ssh-control/
# holds live ControlMaster sockets, neither of which belongs in the repo.
data/hosts.json
data/.ssh-control/

__pycache__/
*.pyc
.venv/
